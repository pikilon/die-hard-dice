{
  "name": "die-hard-dice",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Crea, comparte y lanza sets de dados personalizados en 3D.",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "predev": "npm run icons",
    "dev": "vite",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:5173",
    "prebuild": "npm run icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run icons",
    "typecheck": "tsc -b",
    "pretest": "npm run icons",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.2.0",
    "@fontsource-variable/nunito": "^5.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "fflate": "^0.8.3",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
