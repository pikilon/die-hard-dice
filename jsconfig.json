{
  "compilerOptions": {
    // Enable type checking for JavaScript files
    "checkJs": true,
    
    // Do not emit any output files (this is a no-build project)
    "noEmit": true,
    
    // Target modern JavaScript for browser environments
    "target": "ESNext",
    
    // Use ESNext module system (native ES modules)
    "module": "ESNext",
    
    // Module resolution for modern browser environment
    "moduleResolution": "bundler",
    
    // Include DOM and modern browser APIs
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    
    // Enable all strict type-checking options
    "strict": false,
    
    // Additional checks
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    
    // Allow importing .json files
    "resolveJsonModule": true,
    
    // Ensure consistent casing in imports
    "forceConsistentCasingInFileNames": true,
    
    // Allow JavaScript files to be compiled
    "allowJs": true,
    
    // Support JSX if needed
    "jsx": "preserve",
    
    // Set base URL for module resolution
    "baseUrl": ".",
    
    // Disable implicit any warnings for now (we're gradually typing)
    "noImplicitAny": false
  },
  "include": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
